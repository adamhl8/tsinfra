{
  "name": "tsinfra",
  "version": "0.0.0",
  "description": "An agentless infrastructure as code tool for TypeScript",
  "keywords": [
    "automation",
    "configuration-management",
    "deployment",
    "iac",
    "infrastructure",
    "infrastructure-as-code",
    "provisioning",
    "ssh",
    "typescript"
  ],
  "homepage": "https://github.com/adamhl8/tsinfra",
  "bugs": {
    "url": "https://github.com/adamhl8/tsinfra/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Adam Langbert",
    "email": "adamhl@pm.me",
    "url": "https://github.com/adamhl8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamhl8/tsinfra.git"
  },
  "bin": {
    "tsinfra": "./dist/cli/cli.js"
  },
  "files": [
    "dist/"
  ],
  "type": "module",
  "imports": {
    "#*": "./src/*",
    "#package.json": "./package.json"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "prepare": "bask prepare",
    "report:preview": "bun report-preview.ts"
  },
  "dependencies": {
    "@optique/core": "^1.3.6",
    "@optique/run": "^1.3.6",
    "arktype": "^2.2.9",
    "diff": "^9.0.0",
    "picocolors": "^1.1.1",
    "pretty-bytes": "^7.2.0",
    "ts-explicit-errors": "^5.0.1"
  },
  "devDependencies": {
    "@adamhl8/bask": "^0.6.0",
    "@adamhl8/configs": "^4.0.0",
    "@arethetypeswrong/core": "^0.18.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/bun": "^1.4.4",
    "knip": "^6.44.1",
    "markdown-toc": "^1.2.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "publint": "^0.3.25",
    "release-it": "^21.1.2",
    "release-it-git-cliff": "^0.2.1",
    "tsdown": "^0.23.5",
    "typescript": "7.1.0-beta"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
